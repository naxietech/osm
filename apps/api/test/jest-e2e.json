{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.spec.json" }]
  },
  "moduleNameMapper": {
    "^@oses/types(.*)$": "<rootDir>/../../../packages/types/src$1",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
